{
  "source": "https://facebookresearch.github.io/RAM/blogs/self_improving_memory/",
  "data": "synthetic, generated by run.py from fixed seeds (no external data)",
  "cli": "Claude Code",
  "model_requested": "haiku",
  "task_and_meta_model_same": true,
  "stream_len": 14,
  "groups_per_world": 5,
  "drift_from_task": 9,
  "memory_cap_chars": 2000,
  "train_world_seed": 11,
  "train_stream_seeds": [101, 102],
  "test_world_seeds": [200, 201, 202],
  "test_stream_seeds": [300, 301, 302],
  "seed_harnesses": ["generic", "summary", "skill"],
  "reference_arms": ["no_memory", "transplant"],
  "search": {"iterations": 2, "parents_per_iteration": 2, "selection": "mean train score; seeds included"},
  "decision_line": {
    "metric": "test accuracy over all 14 tasks, mean of 3 unseen worlds",
    "works": "optimized - generic >= 0.10 and optimized >= generic in at least 2 of 3 worlds",
    "does_not_work": "optimized - generic <= 0.02",
    "inconclusive": "anything else"
  },
  "command": [
    "python3", "experiments/E004-meta-optimized-memory-prompts/run.py",
    "--model", "haiku", "--workers", "10",
    "--out", "experiments/E004-meta-optimized-memory-prompts/runs/full"
  ]
}
